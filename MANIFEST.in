include README.zh-CN.md docs/*.md docs/vision/*.md
include docs/teacher/*.md docs/technical/*.md
include examples/*.py examples/courses/*.py
include frontend/package.json frontend/package-lock.json frontend/tsconfig.json frontend/vite.config.js frontend/index.html
recursive-include frontend/src *.ts *.vue
recursive-include packaging/windows *.py *.spec *.ps1 *.cmd *.md *.manifest *.iss *.isl *.txt
recursive-include packaging/linux Dockerfile *.py *.spec *.sh *.md
recursive-include packaging/macos *.py *.spec *.sh *.md
recursive-include packaging/samples *.nuclemu *.md
